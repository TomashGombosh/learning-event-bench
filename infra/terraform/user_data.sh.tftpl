#!/bin/bash
# Cloud-init: install tooling, clone the repo at the requested commit, start the benchmark under systemd.
# Output goes to /var/log/leb-setup.log, syslog, and the serial console (GetConsoleOutput).
set -euxo pipefail
set -E

# cloud-init runs this script with a sparse environment: HOME is unset (git config
# --global dies with "fatal: $HOME not set") and PATH may omit /usr/local/bin.
export HOME=/root
export PATH="/usr/local/sbin:/usr/local/bin:$${PATH:-/usr/sbin:/usr/bin:/sbin:/bin}"

RESULTS_BUCKET="${results_bucket}"
RUN_ID="${run_id}"
AWS_REGION="${region}"
LEB_SETUP_FAILING=0

mkdir -p /var/log/leb
touch /var/log/leb-setup.log /var/log/leb/bench.log

exec > >(stdbuf -oL tee -a /var/log/leb-setup.log | logger -t leb-setup -s 2>/dev/console) 2>&1

on_err() {
  local rc=$?
  local line="$1"
  local cmd="$2"
  if [ "$LEB_SETUP_FAILING" = 1 ]; then
    exit "$rc"
  fi
  LEB_SETUP_FAILING=1
  echo "leb-setup failed at line $line (exit $rc): $cmd" | tee -a /var/log/leb-setup.log >/dev/console || true
  sync /var/log/leb-setup.log || true
  if command -v aws >/dev/null 2>&1; then
    aws s3 cp /var/log/leb-setup.log "s3://$RESULTS_BUCKET/runs/$RUN_ID/setup-failed.log" --region "$AWS_REGION" || true
  else
    echo "aws cli not installed yet; setup-failed.log was not uploaded" >/dev/console || true
  fi
  # A shutdown is already queued (+max_runtime_minutes). logind then rejects PowerOff
  # ("Transaction ... is destructive") and `shutdown -h now` returns without powering off.
  shutdown -c || true
  shutdown -h now "leb-setup failed at line $line" || true
  sleep 15
  systemctl poweroff --force || true
  sleep 5
  poweroff -f || true
  exit "$rc"
}
trap 'on_err "$LINENO" "$BASH_COMMAND"' ERR

# Second line of defence: hard stop after max_runtime_minutes; shutdown behaviour = terminate.
shutdown -h +${max_runtime_minutes} "learning-event-bench safety timeout"

export DEBIAN_FRONTEND=noninteractive

apt_get() {
  local attempt=1
  while [ "$attempt" -le 5 ]; do
    if apt-get -o DPkg::Lock::Timeout=300 "$@"; then
      return 0
    fi
    echo "apt-get failed (attempt $attempt), retrying"
    sleep $((attempt * 5))
    attempt=$((attempt + 1))
  done
  echo "apt-get failed after 5 attempts: $*"
  return 1
}

curl_retry() {
  local attempt=1
  while [ "$attempt" -le 5 ]; do
    if curl -fsSL "$@"; then
      return 0
    fi
    echo "curl failed (attempt $attempt)"
    sleep $((attempt * 2))
    attempt=$((attempt + 1))
  done
  echo "curl failed after 5 attempts"
  return 1
}

# Base packages before any download or unpack. curl/unzip are not in the cloud image.
apt_get update
apt_get install -y ca-certificates curl unzip

# AWS CLI next, so the ERR trap can upload setup-failed.log for every later failure.
case "$(uname -m)" in
  x86_64|aarch64) AWSCLI_ARCH="$(uname -m)" ;;
  *) echo "no AWS CLI v2 build for $(uname -m)"; exit 1 ;;
esac
curl_retry -o /tmp/awscliv2.zip "https://awscli.amazonaws.com/awscli-exe-linux-$AWSCLI_ARCH.zip"
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install

case "$(uname -m)" in
  aarch64|arm64) CW_DEB_ARCH=arm64 ;;
  x86_64|amd64) CW_DEB_ARCH=amd64 ;;
  *) echo "no amazon-cloudwatch-agent package for $(uname -m)"; exit 1 ;;
esac
curl_retry -o /tmp/amazon-cloudwatch-agent.deb \
  "https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/$CW_DEB_ARCH/latest/amazon-cloudwatch-agent.deb"
apt_get install -y /tmp/amazon-cloudwatch-agent.deb

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<EOF
{
  "agent": {
    "run_as_user": "root",
    "region": "${region}"
  },
  "logs": {
    "force_flush_interval": 5,
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/leb-setup.log",
            "log_group_name": "/leb/bench",
            "log_stream_name": "${run_id}/leb-setup.log"
          },
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "/leb/bench",
            "log_stream_name": "${run_id}/cloud-init-output.log"
          },
          {
            "file_path": "/var/log/leb/bench.log",
            "log_group_name": "/leb/bench",
            "log_stream_name": "${run_id}/bench.log"
          }
        ]
      },
      "journald": {
        "collect_list": [
          {
            "units": ["leb-bench.service"],
            "log_group_name": "/leb/bench",
            "log_stream_name": "${run_id}/leb-bench.service"
          }
        ]
      }
    }
  }
}
EOF
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

apt_get install -y docker.io docker-compose-v2 git python3-venv tmux sudo
systemctl enable --now docker
usermod -aG docker ubuntu

# Repo is owned by ubuntu. Any later git as root dies with "dubious ownership".
sudo -Hu ubuntu git clone "${repo_url}" /home/ubuntu/learning-event-bench
sudo -Hu ubuntu git -C /home/ubuntu/learning-event-bench checkout "${git_ref}"
GIT_SHA=$(sudo -Hu ubuntu git -C /home/ubuntu/learning-event-bench rev-parse HEAD)
# BuildKit (root, via leb-bench.service) reads git metadata from this repo.
# --system writes /etc/gitconfig and does not need HOME (cloud-init leaves it unset).
if ! git config --system --get-all safe.directory 2>/dev/null | grep -qxF '*'; then
  git config --system --add safe.directory '*'
fi
if ! git config --system --get-all safe.directory 2>/dev/null | grep -qxF /home/ubuntu/learning-event-bench; then
  git config --system --add safe.directory /home/ubuntu/learning-event-bench
fi
sudo -Hu ubuntu python3 -m venv /home/ubuntu/learning-event-bench/.venv
sudo -Hu ubuntu /home/ubuntu/learning-event-bench/.venv/bin/pip install -q -r /home/ubuntu/learning-event-bench/analysis/requirements.txt

mkdir -p /etc/leb /opt/leb
cat > /etc/leb/bench.env <<ENV
RESULTS_BUCKET=${results_bucket}
RUN_ID=${run_id}
BENCH_REPS=${bench_reps}
BENCH_DURATION_S=${bench_duration_s}
BENCH_PROFILE=${bench_profile}
BENCH_CELLS=${bench_cells}
AWS_REGION=${region}
GIT_SHA=$GIT_SHA
ENV
install -m 755 /home/ubuntu/learning-event-bench/infra/instance/run-bench.sh /opt/leb/run-bench.sh
install -m 755 /home/ubuntu/learning-event-bench/infra/instance/sync-results.sh /opt/leb/sync-results.sh
install -m 755 /home/ubuntu/learning-event-bench/infra/instance/bench-failed.sh /opt/leb/bench-failed.sh

# Root, not ubuntu: usermod -aG docker does not apply to this process, and aws is /usr/local/bin/aws.
cat > /etc/systemd/system/leb-bench.service <<UNIT
[Unit]
Description=learning-event-bench experiment matrix
After=docker.service network-online.target
Requires=docker.service
OnFailure=leb-bench-failed.service
[Service]
Type=simple
User=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/root
EnvironmentFile=/etc/leb/bench.env
ExecStart=/opt/leb/run-bench.sh
Restart=no
[Install]
WantedBy=multi-user.target
UNIT
cat > /etc/systemd/system/leb-bench-failed.service <<UNIT
[Unit]
Description=Upload bench failure logs and power off
[Service]
Type=oneshot
User=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/root
EnvironmentFile=-/etc/leb/bench.env
ExecStart=/opt/leb/bench-failed.sh
UNIT
cat > /etc/systemd/system/leb-sync.service <<UNIT
[Unit]
Description=Upload learning-event-bench results to S3
[Service]
Type=oneshot
User=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/root
EnvironmentFile=/etc/leb/bench.env
ExecStart=/opt/leb/sync-results.sh
UNIT
cat > /etc/systemd/system/leb-sync.timer <<UNIT
[Unit]
Description=Periodic S3 sync of benchmark results
[Timer]
OnBootSec=10min
OnUnitActiveSec=10min
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now leb-sync.timer
systemctl enable --now leb-bench.service
